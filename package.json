{
  "name": "terra-orbit",
  "version": "0.2.0",
  "description": "An AI space harness powered with NASA APIs",
  "license": "MIT",
  "type": "module",
  "bin": {
    "terra-orbit": "bin/terra-orbit.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target bun && cp src/harness/context/*.txt dist/ && cd src/webui && npx vite build && mkdir -p ../../dist/webui && cp -r dist/* ../../dist/webui/",
    "prepublishOnly": "bun run build",
    "web": "bun run src/web/server.ts",
    "web:dev": "bun run --watch src/web/server.ts",
    "web:build": "cd src/webui && npx vite build",
    "web:all": "cd src/webui && npx vite build && cd ../.. && bun run src/web/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theawakener0/terra-orbit.git"
  },
  "bugs": {
    "url": "https://github.com/theawakener0/terra-orbit/issues"
  },
  "homepage": "https://github.com/theawakener0/terra-orbit#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.19",
    "@ai-sdk/tui": "^1.0.16",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@opentui/core": "^0.4.2",
    "ai": "^7.0.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  }
}
